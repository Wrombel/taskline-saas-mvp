{
  "name": "app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest",
    "dev": "concurrently \"pnpm --filter @project/backend dev\" \"pnpm --filter @project/frontend dev\"",
    "build": "pnpm --filter @project/shared build && pnpm --filter @project/backend build && pnpm --filter @project/frontend build",
    "dev:backend": "pnpm --filter @project/backend dev",
    "dev:frontend": "pnpm --filter @project/frontend dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
